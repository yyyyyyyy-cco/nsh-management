# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///data/nsh.db

# JWT 签名密钥（必填，生产必须修改；生成命令：openssl rand -hex 32）
SECRET_KEY=your-secret-key-change-this

# 调试模式（可选，默认 false；生产环境不要开启）
# DEBUG=true

# 开发者账号（首次初始化时使用，可创建帮会、派发账号）
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=your-developer-password

# 默认帮会账号（首次初始化时使用）
ADMIN_PASSWORD=your-admin-password
MEMBER_PASSWORD=your-member-password

# 可选配置
# DEFAULT_GUILD_NAME=默认帮会
# ADMIN_USERNAME=admin
# MEMBER_USERNAME=member
