#!/usr/bin/env bash
# ===== 配置漂移告警（W1-3 的 D-5 回退方案）=====
#
# 依据：合规化整改计划 §3 D-5「生产配置可否去敏入库」②：决策未定前至少提供 diff 告警脚本。
# 用途：部署者在服务器上执行，比对服务器实际配置与仓库内配置，发现「手工改过但没回写仓库」的漂移。
#
# 设计要点：
#   1. 零外部依赖：掩码与逐行比对全部用 bash 内建（[[ =~ ]] / mapfile / 数组 / cd / pwd）。
#      不依赖 sed、diff、grep、awk、dirname、basename —— 旧版依赖它们且未做前置检查，
#      曾导致「掩码静默失效 + 两份相同文件被误报为漂移」。
#   2. 掩码策略：默认只掩码敏感键名的值；端口、镜像标签、路径等保留参与比对，
#      否则会把真正的漂移一并掩掉。更谨慎的场景可加 --mask-all。
#   3. 不改动文件、不连接服务；不打印掩码前的原值。
#
# 要求：bash 4 及以上（使用 mapfile）。
# 用法：
#   bash scripts/check-config-drift.sh.example
#   bash scripts/check-config-drift.sh.example --strict
#   bash scripts/check-config-drift.sh.example --mask-all --strict
#   bash scripts/check-config-drift.sh.example <服务器文件> <仓库文件> [更多成对文件...]
# 退出码：0 无漂移或报告型有漂移；1 strict 且有漂移；2 用法或环境错误

set -u

self_dir="."
case "$0" in
    */*) self_dir="${0%/*}" ;;
    *) self_dir="." ;;
esac
REPO_ROOT="${REPO_ROOT:-$(cd "$self_dir/.." && pwd)}"

STRICT=0
MASK_ALL=0
POS=()

for arg in "$@"; do
    case "$arg" in
        --help|-h)
            n=0
            while IFS= read -r line && [ "$n" -lt 22 ]; do
                if [ "$n" -ge 1 ]; then printf '%s\n' "$line"; fi
                n=$((n + 1))
            done < "$0"
            exit 0
            ;;
        --strict) STRICT=1 ;;
        --mask-all) MASK_ALL=1 ;;
        -*) printf '[config-drift] 未知参数：%s\n' "$arg" >&2; exit 2 ;;
        *) POS+=("$arg") ;;
    esac
done

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '[config-drift] 需要 bash 4 及以上（当前 %s）\n' "${BASH_VERSION:-unknown}" >&2
    exit 2
fi

if [ "${#POS[@]}" -eq 0 ]; then
    PAIRS=(
        "/srv/nsh-management/docker-compose.yml" "$REPO_ROOT/docker-compose.yml"
        "/srv/nsh-management/nginx-proxy.conf" "$REPO_ROOT/frontend/nginx.conf.example"
    )
elif [ "$((${#POS[@]} % 2))" -eq 0 ]; then
    PAIRS=("${POS[@]}")
else
    printf '[config-drift] 位置参数必须成对（服务器文件 仓库文件）\n' >&2
    exit 2
fi

SENSITIVE='(KEY|SECRET|TOKEN|PASSWORD|PASSWD|PWD|CREDENTIAL|DSN|AUTH|SALT)'

mask_line() {
    local line="$1"
    local prefix=""
    local val=""
    local key=""
    if [[ "$line" =~ ^([[:space:]]*-?[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=)(.*)$ ]]; then
        prefix="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        key="${prefix%%=*}"
        if [ "$MASK_ALL" -eq 1 ] || [[ "${key^^}" =~ $SENSITIVE ]]; then
            printf '%s***\n' "$prefix"
        else
            printf '%s%s\n' "$prefix" "$val"
        fi
        return 0
    fi
    if [[ "$line" =~ ^([[:space:]]*[A-Za-z_][A-Za-z0-9_.-]*[[:space:]]*:[[:space:]]*)([^[:space:]]+.*)$ ]]; then
        prefix="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        key="${prefix%%:*}"
        if [ "$MASK_ALL" -eq 1 ] || [[ "${key^^}" =~ $SENSITIVE ]]; then
            printf '%s***\n' "$prefix"
        else
            printf '%s%s\n' "$prefix" "$val"
        fi
        return 0
    fi
    printf '%s\n' "$line"
}

drift=0
checked=0
mode_text="sensitive-only"
if [ "$MASK_ALL" -eq 1 ]; then mode_text="mask-all"; fi
printf '[config-drift] 仓库根目录：%s（掩码模式：%s）\n' "$REPO_ROOT" "$mode_text"

compare_one() {
    local srv="$1"
    local repo="$2"
    local label="$3"
    if [ ! -f "$srv" ]; then
        printf '[config-drift] 跳过 %s：服务器文件不存在（%s）\n' "$label" "$srv"
        return 0
    fi
    if [ ! -f "$repo" ]; then
        printf '[config-drift] 跳过 %s：仓库文件不存在（%s）\n' "$label" "$repo"
        return 0
    fi
    checked=$((checked + 1))
    local -a la=()
    local -a lb=()
    local l=""
    while IFS= read -r l || [ -n "$l" ]; do
        la+=("$(mask_line "$l")")
    done < "$srv"
    while IFS= read -r l || [ -n "$l" ]; do
        lb+=("$(mask_line "$l")")
    done < "$repo"
    local na=${#la[@]}
    local nb=${#lb[@]}
    local max=$na
    if [ "$nb" -gt "$max" ]; then max=$nb; fi
    local diffs=0
    local i=0
    for ((i = 0; i < max; i++)); do
        if [ "${la[i]:-}" != "${lb[i]:-}" ]; then diffs=$((diffs + 1)); fi
    done
    if [ "$diffs" -eq 0 ]; then
        printf '[config-drift] %s：无漂移\n' "$label"
    else
        printf '[config-drift] %s：发现漂移（掩码后差异行 %s / 共 %s 行）——服务器上有改动未回写仓库？\n' "$label" "$diffs" "$max"
        drift=$((drift + 1))
    fi
}

i=0
while [ "$i" -lt "${#PAIRS[@]}" ]; do
    srv_path="${PAIRS[i]}"
    repo_path="${PAIRS[i + 1]}"
    label="${srv_path##*/}"
    compare_one "$srv_path" "$repo_path" "$label"
    i=$((i + 2))
done

printf '[config-drift] 已比对 %s 对文件；漂移 %s 处\n' "$checked" "$drift"
if [ "$checked" -eq 0 ]; then
    printf '[config-drift] 未能比对任何文件：请用位置参数指定服务器路径，或设置 REPO_ROOT\n' >&2
    exit 2
fi
if [ "$drift" -gt 0 ] && [ "$STRICT" -eq 1 ]; then
    exit 1
fi
exit 0