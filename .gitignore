# ===== 类型检查 =====
.mypy_cache/
.pytype/

# ===== 临时文件 =====
*.tmp
*.temp
.cache/
*.bak
*.swp

# ===== Docker =====
docker-compose.override.yml

# ===== 项目特定规则 =====
# 内部文档和规则（不对外公开）
rules/
# AI 编码规则随仓库入库（例外于上一行的 rules/ 忽略，AGENTS.md 以其为权威源）
!.agent/rules/
# .agent/docs 样例：文本 CSV 入库；Excel 分析表体积过大（24MB）仅本地保留
.agent/docs/*.xlsm

# 前端调试截图（开发过程中产生）
frontend/docs/*.png
frontend/docs/*.jpg
frontend/docs/*.jpeg

# 后端测试脚本（包含硬编码测试数据）
backend/scripts/*_test.py
backend/scripts/smoke_test.py

# 压缩包文件（发布产物，不提交源码）
*.tar.gz
*.zip
*.rar

# 系统文件
desktop.ini
# Windows 保留设备名文件（POSIX 风格 shell 中 >nul 重定向误创建）
nul

# 部署脚本与 Nginx 配置（包含服务器 IP/域名/凭据，不提交）
deploy.sh
frontend/nginx.conf

# ===== finesse 设计构建记录（本地记忆，每次构建重写，不提交） =====
.finesse/

