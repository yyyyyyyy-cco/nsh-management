# 后端测试脚本（包含硬编码测试数据）
backend/scripts/*_test.py
backend/scripts/smoke_test.py

# 压缩包文件（发布产物，不提交源码）
*.tar.gz
*.zip
*.rar

# 系统文件
desktop.ini

# 部署脚本与 Nginx 配置（包含服务器 IP/域名/凭据，不提交）
deploy.sh
frontend/nginx.conf

# 本地备份（日常使用文件的备份副本）
_backup/
