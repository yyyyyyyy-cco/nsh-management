.env
.env.local
.env.*.local
.env.production
.env.staging

# ===== 数据库文件 =====
*.db
*.sqlite
*.sqlite3
data/

# ===== 上传文件 =====
uploads/

# ===== 测试覆盖率 =====
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
