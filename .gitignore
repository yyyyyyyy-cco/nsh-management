# ===== 项目特定规则 =====
# 内部文档和规则（不对外公开）
rules/
# AI 编码规则随仓库入库（例外于上一行的 rules/ 忽略，AGENTS.md 以其为权威源）
!.agent/rules/
# .agent/docs 样例：文本 CSV 入库；Excel 分析表体积过大（24MB）仅本地保留
.agent/docs/*.xlsm

# 前端调试截图（开发过程中产生）
frontend/docs/*.png
frontend/docs/*.jpg
frontend/docs/*.jpeg

# 后端测试脚本（包含硬编码测试数据）
backend/scripts/*_test.py
backend/scripts/smoke_test.py

# 压缩包文件（发布产物，不提交源码）
*.tar.gz
*.zip
*.rar

# 系统文件
desktop.ini
# Windows 保留设备名文件（POSIX 风格 shell 中 >nul 重定向误创建）
nul

# 部署脚本（含服务器 IP/用户名/凭据，不提交；占位符模板见 deploy.sh.example）
deploy.sh
# 注：frontend/nginx.conf 自 2026-10-02 起**入库**（作为 frontend 镜像的构建输入，仅含 YOUR_DOMAIN 等占位符）。
# 此前它被本文件忽略且不在仓库内，导致全新克隆执行 docker compose up -d --build 时在 COPY 一步失败
# （合规化计划 F-08 / W1-1）。服务器上的实际配置与之不同，按 DEPLOY.md §三 单独维护；deploy.sh 排除
# 清单仍排除该文件，避免本地占位符版覆盖服务器版本。

# ===== finesse 设计构建记录（本地记忆，每次构建重写，不提交） =====
.finesse/


# ===== 本地临时与构建中间产物（工具在工作区根目录产生，禁止入库） =====
# 2026-10-02 教训：git add -A 曾把 pip 解包目录与临时 venv 一并提交（见 ai-checklist 第 27 条）
.tmp-*/
pip-metadata-*/
pip-unpack-*/