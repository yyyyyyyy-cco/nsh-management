# ===== Docker Compose 部署配置模板 =====
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
# 服务器上生成强随机密钥：openssl rand -hex 32

# JWT 签名密钥（必填，生产必须修改）
# 容器/生产环境下弱密钥（模板占位值、<32 字符、含项目名/单词/年份等可猜片段）将拒绝启动
# 作用域：**容器/Compose 部署权威模板**（`docker-compose.yml` → `env_file: .env`；门禁 `check_env_docs.py` 校验本文件）。
#         本地开发若要手写变量，参考 `backend/.env.example`（其口令为占位值，属预期差异，见 F-65）。
SECRET_KEY=please-change-me-with-openssl-rand-hex-32

# 运行环境标识（可选：production/prod 或 development/dev/test）
# docker-compose.yml 已在 backend 服务固定 APP_ENV=production，此处无需重复设置；
# 非 Compose 部署（k8s/裸机等）必须显式设置 APP_ENV=production，否则启动校验依赖容器特征兜底可能失效
# APP_ENV=production

# 首次初始化账号密码（仅首次建库时生效，之后可在系统内修改）
DEVELOPER_PASSWORD=dev123456
ADMIN_PASSWORD=admin123
MEMBER_PASSWORD=member123

# CORS 允许来源（可选，逗号分隔；2026-10-02 外置，见合规化计划 W4-3）
# 默认值仅为本地开发：http://localhost:5173,http://127.0.0.1:5173
# 生产部署由 Nginx **同源**反代 /api，浏览器不触发跨域，通常**无需设置**本项；
# 仅当 API 被跨域直接调用（独立前端域名 / 第三方调用）时才需显式列出，例如：
# CORS_ORIGINS=https://nsh.example.com,https://admin.example.com
# 安全提示：不要填 `*`（本项目 allow_credentials=True，通配会放宽浏览器侧凭证策略）。

# 错误率告警（可选，2026-10-02 新增，合规化计划 W4-6）
# 判定：最近 ALERT_WINDOW_MINUTES 分钟内 level=error 的审计日志条数达到 ALERT_ERROR_THRESHOLD 即触发。
# 通知：配置 ALERT_WEBHOOK_URL 时 POST JSON（标准库发送，无新依赖）；
#      **未配置时仍会写 WARNING 日志**（容器日志可见，不静默——告警通道在最小配置下即生效）。
# 阈值为 0 或负数表示禁用告警。
# ALERT_ERROR_THRESHOLD=20
# ALERT_WINDOW_MINUTES=30
# ALERT_CHECK_INTERVAL_MINUTES=15
# ALERT_WEBHOOK_URL=https://hooks.example.com/nsh-alert

# ===== 运行时（后端读取，均有默认值；非 Compose 部署时按需覆盖） =====

# 调试模式（可选，默认 false）：true 时返回详细异常信息、并允许 API 文档路由
# ⚠️ 生产必须保持 false（APP_ENV=production 时 /docs、/redoc、/openapi.json 亦被关闭）
# DEBUG=false

# 数据库连接串（可选）：默认 sqlite+aiosqlite:///<数据目录>/nsh.db（容器内数据目录为挂载卷）
# 仅当改用其它路径或外部数据库时才需设置；注意 SQLite 路径必须是绝对路径（四个斜杠）
# DATABASE_URL=sqlite+aiosqlite:////app/data/nsh.db

# 审计日志保留天数（可选，默认 90）：服务启动时清理更早的记录
# LOG_RETENTION_DAYS=90

# ===== 首次初始化账号（仅首次建库时生效，之后可在系统内修改） =====

# 用户名（可选）：默认 developer / admin / member
# DEVELOPER_USERNAME=developer
# ADMIN_USERNAME=admin
# MEMBER_USERNAME=member

# 默认帮会名称（可选，默认「默认帮会」）：仅首次建库时创建该帮会
# DEFAULT_GUILD_NAME=默认帮会
