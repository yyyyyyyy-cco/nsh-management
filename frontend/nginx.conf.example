# ===== 边缘反向代理模板（同机 nginx-proxy 容器的 conf.d/<域名>.conf） =====
# 架构：**单层 TLS**（2026-09-15 改造；权威源 DEPLOY.md §二）
#   · 本文件（B 段）= 边缘层：独占 TLS / 证书 / 限流 / 安全响应头 / HTTP→HTTPS 跳转 / 默认 server 兜底
#   · A 段 = frontend 容器内层，已入库为 `frontend/nginx.conf`（镜像构建输入）。
#     本文件**不再重复维护 A 段**——同一配置两处副本必然漂移（同类问题见合规化计划 F-08/F-40）。
# 使用说明：
#   1. 将 YOUR_DOMAIN 替换为你的域名（如 example.com），YOUR_UPSTREAM 替换为实际容器名
#   2. 证书路径按实际情况修改（Let's Encrypt：/etc/letsencrypt/live/域名/）
#   3. 限流参数与上传大小按需调整；内层以 set_real_ip_from 识别真实 IP，边缘层必须覆盖而非追加 XFF
#   4. 本文件不入部署包（deploy.sh 排除清单），服务器侧改动遵循 DEPLOY.md §三
# 详见 DEPLOY.md §二（部署架构）

upstream YOUR_UPSTREAM {
    server nsh-management-frontend-1:80;
    keepalive 32;
}

# 接口限流：通用 API 20r/s，登录 5r/min（按真实客户端 IP）
limit_req_zone $binary_remote_addr zone=api:1m rate=20r/s;
limit_req_zone $binary_remote_addr zone=login:1m rate=5r/m;

# 拒绝非域名访问（IP 直接访问等）
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/ssl/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/YOUR_DOMAIN/privkey.pem;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    ssl_certificate     /etc/nginx/ssl/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/YOUR_DOMAIN/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    server_tokens off;
    client_max_body_size 20m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'self';" always;

    location = /api/v1/auth/login {
        limit_req zone=login burst=3 nodelay;
        limit_req_status 429;
        error_page 429 = @rate_limited;
        proxy_pass http://YOUR_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        error_page 429 = @rate_limited;
        proxy_pass http://YOUR_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location @rate_limited {
        default_type application/json;
        return 429 '{"code":429,"message":"请求过于频繁，请稍后重试","data":null}';
    }

    location / {
        proxy_pass http://YOUR_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}